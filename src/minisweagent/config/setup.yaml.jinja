# Generated and tested by mini setup; loaded automatically over the bundled mini.yaml.
# Edit this file to change defaults. Explicit mini -c options replace this config.
# With -c, include mini.yaml first to load the bundled prompts.
# Server context window: {{ context if context else 'not advertised' }} tokens.
# Context size is configured on the server, not by this client.

model:
  model_class: llamacpp
  base_url: {{ base_url | tojson }}
  model_name: {{ model | tojson }}
  verify_ssl: {{ verify_ssl | tojson }}  # TLS certificate/hostname checks; false accepts invalid certificates.
{% if api_key_env %}
  api_key_env: {{ api_key_env | tojson }}  # Read the bearer token from this environment variable.
{% else %}
  # api_key_env: OPENAI_API_KEY  # Optional bearer token; only the variable name is saved.
{% endif %}
  # Discovery/startup checks default to 3 seconds; override with --check-timeout SECONDS.
  request_timeout: {{ request_timeout | tojson }}  # Seconds without response data; null disables. No total generation deadline.
  # connect_timeout: 10   # Seconds to establish the HTTP connection.
  model_kwargs:
    # Server temperature when advertised; otherwise the deterministic client default.
    temperature: {{ temperature | tojson }}
    # Reply token budget; capped at half the advertised context to leave prompt space.
    max_tokens: {{ max_tokens }}
    # Optional sampling overrides; examples use server defaults when advertised.
    # top_p: {{ params.get('top_p', 1.0) | tojson }}  # Keep tokens within this cumulative probability.
    # top_k: {{ params.get('top_k', 40) | tojson }}   # llama.cpp: restrict sampling to this many tokens.
    # min_p: {{ params.get('min_p', 0.05) | tojson }}  # llama.cpp: minimum probability relative to the best token.
    # seed: 42  # Fixed sampling seed for repeatable requests.
    # repeat_penalty: {{ params.get('repeat_penalty', 1.0) | tojson }}  # llama.cpp: discourage repetition when greater than 1.

# agent:
#   audit_timeout: 0  # Seconds per command: 0 runs immediately; positive values wait; .inf requires an empty submission.
#   mode: agent  # agent: sample commands from the model; human: enter commands yourself.
#   confirm_exit: true  # Ask for another task when the model finishes.
#   code_theme: ansi_dark  # Code colors: ansi_dark, ansi_light, or a Pygments theme name.
#   step_limit: 0  # Maximum model calls per run; 0 means unlimited. Override with --step-limit N.
#   max_context_chars: 65536  # Text budget, not tokens; retain task, corrections and recent turns. Override compact() to customize.
#   max_consecutive_format_errors: 3  # Stop after repeated malformed actions.

environment:  # Actions run locally unless the Podman sandbox is enabled.
  language: {{ language }}  # python or bash; every action starts a fresh interpreter.
  # interpreter: ["/path/to/venv/bin/python", "-u", "-c"]  # Python defaults to mini's interpreter, unbuffered.
  # cwd: /path/to/project  # Working directory for actions; defaults to the current directory.
  # timeout: 300  # Seconds without output or process-group CPU/I/O activity; null disables.
  # max_output_bytes: 16384  # Head/tail excerpt for the model; full logs are kept beside the trajectory.
  # output_dir: /path/to/logs  # Override the command-log directory.
  # environment_class: podman  # --sandbox enables offline containers; --ask-network enables per-script requests.
  # image: localhost/agent-workspace:latest  # Must already exist locally; mini never pulls images.
  # network: none  # Podman: none or ask. '# network: reason' requests one script's access; ask requires typed yes.
  # offline_prompt: true  # Podman network:none: tell the model to avoid internet-dependent operations; --no-offline-prompt disables.
