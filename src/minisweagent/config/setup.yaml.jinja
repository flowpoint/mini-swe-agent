# Generated and tested by mini setup; loaded automatically over the bundled mini.yaml.
# Edit this file to change defaults. Explicit mini -c options replace this config.
# With -c, include mini.yaml first to load the bundled prompts.
# Server context window: {{ context if context else 'not advertised' }} tokens.
# Context size is configured on the server, not by this client.

model:
  model_class: llamacpp
  base_url: {{ base_url | tojson }}
  model_name: {{ model | tojson }}
  # Startup and setup checks default to 3 seconds; override with --check-timeout SECONDS.
  # request_timeout: 600  # Seconds to wait for a generated response.
  # connect_timeout: 10   # Seconds to establish the HTTP connection.
  model_kwargs:
    # Server temperature when advertised; otherwise the deterministic client default.
    temperature: {{ temperature | tojson }}
    # Reply token budget; capped at half the advertised context to leave prompt space.
    max_tokens: {{ max_tokens }}
    # Optional sampling overrides; examples use server defaults when advertised.
    # top_p: {{ params.get('top_p', 1.0) | tojson }}  # Keep tokens within this cumulative probability.
    # top_k: {{ params.get('top_k', 40) | tojson }}   # llama.cpp: restrict sampling to this many tokens.
    # min_p: {{ params.get('min_p', 0.05) | tojson }}  # llama.cpp: minimum probability relative to the best token.
    # seed: 42  # Fixed sampling seed for repeatable requests.
    # repeat_penalty: {{ params.get('repeat_penalty', 1.0) | tojson }}  # llama.cpp: discourage repetition when greater than 1.

# agent:
#   audit_timeout: 0  # Seconds per command: 0 runs immediately; positive values wait; .inf requires an empty submission.
#   mode: agent  # agent: sample commands from the model; human: enter commands yourself.
#   confirm_exit: true  # Ask for another task when the model finishes.
#   code_theme: ansi_dark  # Code colors: ansi_dark, ansi_light, or a Pygments theme name.
#   step_limit: 100  # Maximum model calls per run; 0 disables this limit.
#   wall_time_limit_seconds: 3600  # Maximum run duration; 0 disables this limit.
#   max_consecutive_format_errors: 3  # Stop after repeated malformed Bash actions.

# environment:  # Commands run where mini runs; start mini inside your container for isolation.
#   cwd: /path/to/project  # Working directory for shell commands; defaults to the current directory.
